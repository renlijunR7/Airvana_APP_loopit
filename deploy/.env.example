# Airvana 生产环境配置模板
# 复制为 /opt/airvana/.env 并逐项填写。带 <> 的必须替换。

NODE_ENV=production

# 会话/签名密钥：必须自己生成，命令：openssl rand -hex 32
APP_SECRET=<openssl-rand-hex-32-生成的随机串>

# 监听：只监听本机，由 Nginx 对外
HOST=127.0.0.1
PORT=8082

# HTTPS 下必须为 true（Nginx 已做 TLS 终止）
COOKIE_SECURE=true

# 仅信任本机 Nginx 传入的 X-Forwarded-*，用于 HTTPS 钱包签名与真实来源限流
TRUST_PROXY=loopback

# 数据库放持久目录（不要用仓库内 data/ 的开发库）
DATABASE_PATH=/var/lib/airvana/airvana.db

# 跨域来源（Flutter Web / 独立前端域名，多个用逗号分隔；纯 App+同域网页可留空）
CORS_ALLOWED_ORIGINS=https://<你的域名>

# AI 生成：local = 本地模拟（零成本，当前口径）；openai = 真实生成
AI_PROVIDER=local
# AI_PROVIDER=openai 时打开以下三行
# OPENAI_API_KEY=<sk-...>
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 生产环境 demo 登录默认关闭（NODE_ENV=production 时自动关闭，无需设置）
# ALLOW_DEMO_AUTH=false

# 限流（默认值已合理，按需调整）
# API_RATE_LIMIT=600
# AUTH_RATE_LIMIT=60
