PORT=8082
HOST=127.0.0.1
NODE_ENV=development
DATABASE_PATH=./data/airvana.db
APP_SECRET=replace-with-a-long-random-secret
ALLOW_DEMO_AUTH=true
COOKIE_SECURE=false
RUNTIME_MIN_DURATION_MS=2000
AUTH_RATE_LIMIT=30
API_RATE_LIMIT=180

# Keep AI_PROVIDER=local for offline development. Set OPENAI_API_KEY and
# AI_PROVIDER=openai to use the external generation + moderation adapters.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_BASE_URL=https://api.openai.com/v1
