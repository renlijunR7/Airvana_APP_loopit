    "target_duration_seconds": 45,
    "difficulty": {
      "minimum": 1,
      "maximum": 3,
      "default": 2
    },
    "input_modes": [
      "tap",
      "keyboard",
      "microphone"
    ],
    "state_transitions": [
      {
        "from": "intro",
        "event": "start",
        "to": "playing",
        "guard": null
      },
      {
        "from": "playing",
        "event": "pause",
        "to": "paused",
        "guard": null
      },
      {
        "from": "paused",
        "event": "resume",
        "to": "playing",
        "guard": null
      },
      {
        "from": "playing",
        "event": "complete_success",
        "to": "success",
        "guard": "Completion condition is met"
      },
      {
        "from": "playing",
        "event": "complete_failure",
        "to": "failure",
        "guard": "Completion condition is not met"
      },
      {
        "from": "failure",
        "event": "retry",
        "to": "playing",
        "guard": null
      },
      {
        "from": "success",
        "event": "finish",
        "to": "exit",
        "guard": null
      },
      {
        "from": "failure",
        "event": "exit",
        "to": "exit",
        "guard": null
      }
    ],
    "scoring": {
      "enabled": true,
      "rule": "Existing local preview scoring rules",
      "minimum": 0,
      "maximum": 999999
    }
