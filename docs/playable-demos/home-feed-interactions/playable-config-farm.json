  "locales": {"default": "zh-CN", "supported": ["zh-CN"]},
  "presentation": {
    "title": "星际农场能量田",
    "tone": "warm and playful",
    "theme": "neon community farm",
    "logo_asset_id": "asset_local_airvana_logo",
    "color_tokens": {"primary": "#8EF0A9", "secondary": "#62C7FF", "background": "#0D241A", "text": "#FFFFFF"},
    "copy_pack": {"intro_headline": "点亮 5 块能量田", "intro_body": "点击发光地块，避开故障地块。", "start_button": "开始种植", "success_title": "能量田已点亮", "failure_title": "能量不足", "retry_button": "重新种植", "reward_eligibility": "不发放奖励。", "reward_terms": "本地分数仅用于演示。"}
