  "gameplay": {
    "mechanic": "tap_challenge",
    "core_loop": "Tap the highlighted plot, move the highlight, avoid incorrect plots, and complete five valid taps before lives reach zero.",
    "rounds": 5,
    "target_duration_seconds": 20,
    "difficulty": {"minimum": 1, "maximum": 5, "default": 2},
