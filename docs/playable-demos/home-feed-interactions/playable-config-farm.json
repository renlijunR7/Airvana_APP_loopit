      {"from": "playing", "event": "complete_success", "to": "success", "guard": "score = 5"},
      {"from": "playing", "event": "complete_failure", "to": "failure", "guard": "lives = 0"},
      {"from": "failure", "event": "retry", "to": "playing", "guard": null},
      {"from": "success", "event": "exit", "to": "exit", "guard": null}
    ],
    "scoring": {"enabled": true, "rule": "One point per highlighted plot; three lives.", "minimum": 0, "maximum": 5}
  },
  "screens": [
    {"screen_id": "farm_intro", "state": "intro", "copy_keys": ["intro_headline", "intro_body", "start_button"], "asset_ids": ["asset_builtin_game_shapes"], "actions": ["start"]},
    {"screen_id": "farm_playing", "state": "playing", "copy_keys": [], "asset_ids": ["asset_builtin_game_shapes"], "actions": ["tap_plot"]},
    {"screen_id": "farm_success", "state": "success", "copy_keys": ["success_title"], "asset_ids": ["asset_builtin_game_shapes"], "actions": ["replay", "exit"]},
    {"screen_id": "farm_failure", "state": "failure", "copy_keys": ["failure_title", "retry_button"], "asset_ids": ["asset_builtin_game_shapes"], "actions": ["retry", "exit"]}
  ],
