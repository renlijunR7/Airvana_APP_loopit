  "field_authority": {"locked_fields": ["cta", "reward_presentation", "constraints", "telemetry"], "editable_fields": ["presentation.copy_pack"], "agentic_fields": [], "runtime_fields": ["runtime.session_id", "runtime.locale", "runtime.device_class"]},
  "runtime_policy": {"segmentation_inputs": ["locale", "device_class"], "agentic_bounds": [], "experiment_id": null, "variant_id": null, "fallback_behavior": "Render the static intro with a retry action if gameplay cannot initialize."},
